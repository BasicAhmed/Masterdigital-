rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public: the site shows rates and contact details to everyone.
    match /routes/{route} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Private: customers and transactions are staff-only.
    match /customers/{doc} {
      allow read, write: if request.auth != null;
    }
    match /transactions/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
